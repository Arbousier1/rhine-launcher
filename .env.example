# Rhine Launcher — environment configuration
#
# Copy to `.env` for local development. `.env` is git-ignored; never commit it.
#
# IMPORTANT: only the server process reads these. The launcher's HTTP API never
# returns secret values (see packages/core/src/plugins/public-value.ts), and the
# frontend bundle never receives them.

# ---------------------------------------------------------------------------
# Microsoft / Minecraft premium ("正版") login
# ---------------------------------------------------------------------------
# Your own Microsoft Entra app registration's Application (client) ID.
# Device-code login is a PUBLIC client flow — no client secret is needed or used.
# See docs/MICROSOFT-OAUTH-APP-ID.md for how to create one.
RHINE_MICROSOFT_CLIENT_ID=

# Tenant authority. `consumers` for personal Microsoft accounts,
# `organizations` for work/school only, or a tenant GUID.
# Default when unset: https://login.microsoftonline.com/consumers/oauth2/v2.0
RHINE_MICROSOFT_AUTHORITY=consumers

# ---------------------------------------------------------------------------
# CurseForge
# ---------------------------------------------------------------------------
# CurseForge issues API keys per applicant after a manual Overwolf review.
# It cannot be self-registered or derived from a public page. Request one at
# https://forms.monday.com/forms/dce5ccb7afda9a1c21dab1a1aa1d84eb?r=use1
# Leave empty to keep CurseForge tabs hidden — Modrinth still works.
# NEVER bundle this into a client build; it is a server-held credential.
RHINE_CURSEFORGE_API_KEY=

# ---------------------------------------------------------------------------
# Optional overrides
# ---------------------------------------------------------------------------
# Launcher data directory (default: %APPDATA%\RhineLauncher)
# RHINE_HOME=
# HTTP port (default: 6550)
# RHINE_PORT=
